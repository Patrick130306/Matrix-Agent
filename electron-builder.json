{
  "appId": "com.matrixagent.app",
  "productName": "Matrix Agent",
  "asar": true,
  "asarUnpack": ["**/node_modules/better-sqlite3/**"],
  "npmRebuild": false,
  "files": ["dist/**", "package.json"],
  "extraResources": [
    {
      "from": "${LOCALAPPDATA}/ms-playwright/chromium-1228",
      "to": "chromium",
      "filter": ["chrome-win64/**"]
    }
  ],
  "directories": { "output": "release", "buildResources": "build" },
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.png"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.productivity"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Matrix Agent"
  }
}
